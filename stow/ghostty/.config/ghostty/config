# Font
font-family = Cica
font-style = Bold
font-size = 17
adjust-cell-width = -10%

# Window
macos-titlebar-style = tabs
macos-option-as-alt = left
macos-option-as-alt = right

# Keybind
# Ctrl+Shift+J は IME のかな切替に使う。ターミナル内のプログラムへは Ctrl+J (改行) として
# 届き、cc-ask-dotfiles の REPL や nvim の入力欄で「入力の確定」になってしまうので、
# Ghostty で握り潰して子プロセスへ渡さない (OS や IME 側の処理は妨げない)。
keybind = ctrl+shift+j=ignore

# Oceanic Next color scheme
background = 1b2b34
foreground = d8dee9
cursor-color = d8dee9
selection-background = d8dee9
selection-foreground = 1b2b34

# ANSI colors
palette = 0=#29414f
palette = 1=#ec5f67
palette = 2=#99c794
palette = 3=#fac863
palette = 4=#6699cc
palette = 5=#c594c5
palette = 6=#5fb3b3
palette = 7=#65737e

# Bright colors
